{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hum.ai/contracts/kgdb/consumes/sldb_kgdb_semantic_export.schema.json",
  "title": "SLDB KGDB Semantic Export",
  "description": "Versioned SLDB semantic artifact payload consumed by KGDB. KGDB treats this as graph input provenance and vocabulary data; it does not scrape SLDB runtime internals or perform semantic reasoning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "producer",
    "store",
    "models",
    "documents",
    "sections",
    "semantic_dag"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "sldb_kgdb_semantic_export"},
        "version": {"const": 1},
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp for this materialized export."
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "sldb"},
        "version": {"type": "string", "minLength": 1},
        "command": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Optional argv used to produce the export."
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "store_path", "hash_a"],
      "properties": {
        "root": {
          "type": "string",
          "description": "Project-root path as supplied by the exporter."
        },
        "store_path": {
          "type": "string",
          "description": "Path to the store directory as supplied by the exporter."
        },
        "hash_a": {
          "type": "string",
          "minLength": 1,
          "description": "Store-level integrity hash from StoreIndex.hash_a."
        },
        "runtime_sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "store_index": {"type": "string"},
            "semantic_index": {"type": "string"},
            "semantic_dag": {"type": "string"},
            "sections_indexes": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "description": "Optional diagnostic source paths. KGDB must treat these as provenance, not as files to scrape."
        }
      }
    },
    "models": {
      "type": "array",
      "items": {"$ref": "#/$defs/model"}
    },
    "documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/document"}
    },
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    },
    "semantic_dag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "equivalences"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/semantic_node"}
        },
        "equivalences": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"$ref": "#/$defs/vocabulary_term"},
            "uniqueItems": true
          },
          "description": "Maps local semantic tags to equivalent global tags."
        }
      }
    }
  },
  "$defs": {
    "vocabulary_term": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "description": "SLDB semantic tag or KGDB graph vocabulary token."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model_ref",
        "path",
        "models_index",
        "documents_index",
        "version",
        "canonical",
        "semantics",
        "base_models",
        "hash_b"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "model_ref": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "models_index": {"type": "string", "minLength": 1},
        "documents_index": {"type": "string", "minLength": 1},
        "sections_index": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "canonical": {"type": "boolean"},
        "family": {"type": ["string", "null"]},
        "semantics": {
          "type": "array",
          "items": {"$ref": "#/$defs/vocabulary_term"},
          "uniqueItems": true,
          "description": "Flattened model-level semantic tags."
        },
        "base_models": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "hash_b": {"type": "string", "minLength": 1}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "model",
        "path",
        "hash_c",
        "hash_d",
        "semantic_tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable export id. Recommended form: <model>:<document name>."
        },
        "name": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "hash_c": {"type": "string", "minLength": 1},
        "hash_d": {"type": "string", "minLength": 1},
        "semantic_tags": {
          "type": "array",
          "items": {"$ref": "#/$defs/vocabulary_term"},
          "uniqueItems": true
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_id",
        "path",
        "title",
        "breadcrumbs",
        "about",
        "semantic_tags",
        "slug",
        "level"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable export id. Recommended form: <document id>#<section path>."
        },
        "document_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "breadcrumbs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "about": {
          "type": "array",
          "items": {"type": "string"}
        },
        "semantic_tags": {
          "type": "array",
          "items": {"$ref": "#/$defs/vocabulary_term"},
          "uniqueItems": true
        },
        "slug": {"type": "string", "minLength": 1},
        "level": {"type": "integer", "minimum": 1, "maximum": 6},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "semantic_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parents"],
      "properties": {
        "id": {"$ref": "#/$defs/vocabulary_term"},
        "parents": {
          "type": "array",
          "items": {"$ref": "#/$defs/vocabulary_term"},
          "uniqueItems": true
        }
      }
    }
  }
}
